# docker-compose.prod.yml 이 읽는 운영 환경변수 — 복사해 .env.prod 로 만들고 값을 채운다. .env.prod 는 커밋 금지.
# 각 항목의 뜻은 backend/src/main/resources/application-prod.properties 머리말과 backend/docs/배포_운영절차.md §2 참조.
#
# DB는 RDS가 아니라 H2 파일(팀 결정 — 파일럿 규모, ./data/db 볼륨에 저장). 그래서 SPRING_DATASOURCE_* 환경변수가 없다.
# RDS로 되돌리려면 배포 문서 §1~§3과 이 파일의 과거 버전(git history)을 참고할 것.
# 주의: 예전에 RDS로 배포해본 서버라 .env.prod에 SPRING_DATASOURCE_URL/USERNAME/PASSWORD가 남아있으면
# 반드시 지울 것 — OS 환경변수가 application-prod.properties보다 우선순위가 높아서, 남아있으면 H2 설정을
# 조용히 무시하고 예전 RDS로 다시 붙는다(RDS가 이미 삭제됐으면 기동 실패, 살아있으면 더 위험하게 조용히 붙는다).

# --- 필수: 인증·도메인 ---
# openssl rand -base64 48 으로 생성. 바꾸면 발급된 운영자 로그인이 전부 풀린다
BOOTLOCK_JWT_SECRET=CHANGE_ME_at_least_32_bytes_random
# 손님 프론트 도메인 — QR에 인쇄되는 값. 인쇄 후 변경 불가.
# 팀 결정: 도메인·HTTPS 없이 프론트도 이 EC2에 같이 올린다(80번 포트, nginx가 /api·/uploads를 내부망으로
# api 컨테이너에 중계) — http://<EC2 퍼블릭 IP 또는 퍼블릭 DNS>
BOOTLOCK_CUSTOMER_BASE_URL=http://CHANGE_ME
# 프론트·API가 같은 80번 포트(같은 오리진)로 나가므로 실제로는 크로스 오리진 요청이 없어 CORS가 개입할 일이
# 없지만, 이 값 자체는 기동 필수(비우면 기동 실패)라 위와 같은 값을 넣어 둔다
BOOTLOCK_CORS_ALLOWED_ORIGINS=http://CHANGE_ME

# --- 시딩: 첫 배포에서 1회만 true, 끝나면 false 로 되돌리고 재기동 ---
BOOTLOCK_SEED_ENABLED=false
BOOTLOCK_SEED_FILE=/app/seed/event-seed.json
# 시딩 파일의 passwordEnv 이름과 맞춘다 (부스 수만큼)
BOOTLOCK_SEED_PASSWORD_CHANGE_ME_1=CHANGE_ME
BOOTLOCK_SEED_PASSWORD_CHANGE_ME_2=CHANGE_ME

# --- 선택 ---
# 계좌 변경(O17) 알림 웹훅 (Slack/Discord incoming webhook 등). 비우면 알림 없음
BOOTLOCK_OPERATIONS_WEBHOOK_URL=
# 좌석 유휴 임계(분)·E1 캐시(초) — 기본 180 / 10. 철자 BOOTHLOCK(H 포함)
#BOOTHLOCK_EVENT_SEATIDLEMINUTES=180
#BOOTHLOCK_EVENT_BOOTHSCACHESECONDS=10
# swagger-ui 공개 여부 (기본 false)
#BOOTLOCK_SWAGGER_ENABLED=false
# 회원가입(O0, 임시 데모) 공개 여부 (기본 false — 신원 확인 없어 부스 사칭 위험). 시연·심사 때만 true로.
#   둘을 같이 켜야 한다 — BOOTLOCK_*는 API(실제 차단막), VITE_*는 로그인 화면의 회원가입 링크 노출이다.
#   VITE_*는 빌드 시점에 박히므로 바꾼 뒤 docker compose up -d --build 로 프론트를 다시 빌드해야 반영된다.
#   정확히 true(대소문자 무시)일 때만 켜진다 — 빈 값·오타·미설정은 전부 꺼짐으로 처리된다.
#BOOTLOCK_SIGNUP_ENABLED=false
#VITE_SIGNUP_ENABLED=false

# ── DB 선택: H2(기본) ↔ RDS MySQL ─────────────────────────────────────────────
#   이 파일 한 곳에서만 고른다. 재배포 명령은 어느 쪽이든 같다:
#       git pull && docker compose -f docker-compose.prod.yml up -d --build
#
#   H2(기본): 아래 네 줄을 두지 않는다(주석 그대로).
#   RDS     : 네 줄의 주석을 푼다. 네 줄은 한 묶음이다 — 하나만 빠져도 기동이 멈추고
#             로그에 무엇을 고치라고 나온다(반쯤 켜진 채로 조용히 뜨지 않는다).
#   되돌리기: 네 줄을 다시 주석 처리하고 같은 명령으로 재배포.
#             ★ 되돌리면 RDS에 쌓인 데이터는 H2로 오지 않는다. 운영 중에는 되돌리지 말 것 ★
#
#   URL 쿼리스트링을 빠뜨리지 말 것 — serverTimezone이 없으면 영업일 06:00 경계가 어긋난다.
#   connectTimeout(5초)·socketTimeout(30초)은 URL에 붙이지 않는다 — application-rds.properties가
#   hikari data-source-properties로 건다(끊긴 소켓에 요청 스레드가 무한 대기하는 것을 막는다, 이유는 그 파일 주석).
#   URL에도 적으면 값이 두 곳이 되어 헷갈린다.
#SPRING_PROFILES_ACTIVE=prod,rds
#SPRING_DATASOURCE_URL=jdbc:mysql://<RDS 엔드포인트>:3306/boothlock?serverTimezone=Asia/Seoul&characterEncoding=UTF-8&connectionCollation=utf8mb4_0900_ai_ci
#   마스터 계정이 아니라 DML 전용 계정(boothlock_app)을 쓴다 — 스키마는 사람이 적용하고 앱은 대조만 한다
#SPRING_DATASOURCE_USERNAME=boothlock_app
#SPRING_DATASOURCE_PASSWORD=
