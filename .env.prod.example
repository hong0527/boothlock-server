# docker-compose.prod.yml 이 읽는 운영 환경변수 — 복사해 .env.prod 로 만들고 값을 채운다. .env.prod 는 커밋 금지.
# 각 항목의 뜻은 backend/src/main/resources/application-prod.properties 머리말과 backend/docs/배포_운영절차.md §2 참조.

# --- 필수: RDS MySQL 8.0 ---
# characterEncoding 은 반드시 UTF-8 (utf8mb4 라고 쓰면 드라이버가 연결을 거부한다)
SPRING_DATASOURCE_URL=jdbc:mysql://CHANGE_ME.ap-northeast-2.rds.amazonaws.com:3306/boothlock?serverTimezone=Asia/Seoul&characterEncoding=UTF-8&connectionCollation=utf8mb4_0900_ai_ci
SPRING_DATASOURCE_USERNAME=boothlock_app
SPRING_DATASOURCE_PASSWORD=CHANGE_ME

# --- 필수: 인증·도메인 ---
# openssl rand -base64 48 으로 생성. 바꾸면 발급된 운영자 로그인이 전부 풀린다
BOOTLOCK_JWT_SECRET=CHANGE_ME_at_least_32_bytes_random
# 손님 프론트 도메인 — QR에 인쇄되는 값. 인쇄 후 변경 불가
BOOTLOCK_CUSTOMER_BASE_URL=https://CHANGE_ME.example.com
# 프론트 배포 오리진(쉼표 구분, 경로·끝 슬래시 없이). 위 도메인과 반드시 일치
BOOTLOCK_CORS_ALLOWED_ORIGINS=https://CHANGE_ME.example.com

# --- 시딩: 첫 배포에서 1회만 true, 끝나면 false 로 되돌리고 재기동 ---
BOOTLOCK_SEED_ENABLED=false
BOOTLOCK_SEED_FILE=/app/seed/event-seed.json
# 시딩 파일의 passwordEnv 이름과 맞춘다 (부스 수만큼)
BOOTLOCK_SEED_PASSWORD_CHANGE_ME_1=CHANGE_ME
BOOTLOCK_SEED_PASSWORD_CHANGE_ME_2=CHANGE_ME

# --- 선택 ---
# 계좌 변경(O17) 알림 웹훅 (Slack/Discord incoming webhook 등). 비우면 알림 없음
BOOTLOCK_OPERATIONS_WEBHOOK_URL=
# 좌석 유휴 임계(분)·E1 캐시(초) — 기본 180 / 10. 철자 BOOTHLOCK(H 포함)
#BOOTHLOCK_EVENT_SEATIDLEMINUTES=180
#BOOTHLOCK_EVENT_BOOTHSCACHESECONDS=10
# swagger-ui 공개 여부 (기본 false)
#BOOTLOCK_SWAGGER_ENABLED=false
